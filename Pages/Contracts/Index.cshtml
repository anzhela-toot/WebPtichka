@page
@model WebPtichka.Pages.Contracts.IndexModel
@{
    ViewData["Title"] = "Договоры";
}

<h1>Договоры</h1>

<div class="mb-3">
    <a asp-page="/Contracts/Create" class="btn btn-success">Оформить договор</a>
    <a asp-page="/Index" class="btn btn-secondary">На главную</a>
</div>

<!-- ============ Панель поиска ============ -->
<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Поиск</label>
                <input type="text"
                       name="search"
                       value="@Model.Search"
                       class="form-control"
                       placeholder="№ договора или ФИО клиента..." />
            </div>

            <div class="col-md-2">
                <label class="form-label">Зал</label>
                <select name="hallId" class="form-select" asp-items="Model.HallsList">
                    <option value="">Все залы</option>
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label">Статус</label>
                <select name="status" class="form-select">
                    <option value="">Все статусы</option>
                    @foreach (var s in Model.StatusesList)
                    {
                        <option value="@s" selected="@(s == Model.Status)">@s</option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label">Дата с</label>
                <input type="date"
                       name="dateFrom"
                       value="@(Model.DateFrom?.ToString("yyyy-MM-dd"))"
                       class="form-control" />
            </div>

            <div class="col-md-2">
                <label class="form-label">по</label>
                <input type="date"
                       name="dateTo"
                       value="@(Model.DateTo?.ToString("yyyy-MM-dd"))"
                       class="form-control" />
            </div>

            <div class="col-md-1 d-flex gap-1">
                <button type="submit" class="btn btn-primary" title="Найти">🔍</button>
                <a asp-page="/Contracts/Index" class="btn btn-secondary" title="Сбросить">✕</a>
            </div>
        </form>

        @if (!string.IsNullOrWhiteSpace(Model.Search) || Model.HallId.HasValue
             || !string.IsNullOrWhiteSpace(Model.Status)
             || Model.DateFrom.HasValue || Model.DateTo.HasValue)
        {
            <div class="mt-2 text-muted small">
                Найдено: <strong>@Model.Contracts.Count</strong> из @Model.TotalCount
                @if (!string.IsNullOrWhiteSpace(Model.Search))
                {
                    <span> · по запросу «@Model.Search»</span>
                }
            </div>
        }
    </div>
</div>

<!-- ============ Таблица ============ -->
<table class="table table-hover mt-3">
    <thead>
        <tr>
            <th>№</th>
            <th>Клиент</th>
            <th>Сотрудник</th>
            <th>Зал</th>
            <th>Дата</th>
            <th>Время</th>
            <th>Сумма</th>
            <th>Статус</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Contracts.Count == 0)
        {
            <tr>
                <td colspan="9" class="text-center text-muted py-4">
                    @if (!string.IsNullOrWhiteSpace(Model.Search) || Model.HallId.HasValue
                         || !string.IsNullOrWhiteSpace(Model.Status)
                         || Model.DateFrom.HasValue || Model.DateTo.HasValue)
                    {
                        <span>🔍 По вашему запросу ничего не найдено.
                            <a asp-page="/Contracts/Index">Сбросить фильтры</a></span>
                    }
                    else
                    {
                        <span>Пока нет ни одного договора</span>
                    }
                </td>
            </tr>
        }
        else
        {
            @foreach (var c in Model.Contracts)
            {
                <tr>
                    <td>@c.ContractNumber</td>
                    <td>@c.Client?.FullName</td>
                    <td>@c.Employee?.FullName</td>
                    <td>@c.Hall?.HallName</td>
                    <td>@c.EventDate.ToString("dd.MM.yyyy")</td>
                    <td>@c.StartTime.ToString("HH:mm") - @c.EndTime.ToString("HH:mm")</td>
                    <td>@c.TotalAmount ₽</td>
                    <td>
                        @{
                            var statusClass = c.ContractStatus?.ToLower() switch
                            {
                                "активен" or "active" => "badge bg-success",
                                "завершён" or "завершен" or "completed" => "badge bg-secondary",
                                "отменён" or "отменен" or "cancelled" => "badge bg-danger",
                                _ => "badge bg-warning text-dark"
                            };
                        }
                        <span class="@statusClass">@c.ContractStatus</span>
                    </td>
                    <td>
                        <a asp-page="/Contracts/Edit" asp-route-id="@c.Id"
                           class="btn btn-sm btn-primary">Изменить</a>

                        <form method="post" asp-page-handler="Delete"
                              asp-route-id="@c.Id" style="display:inline">
                            <button type="submit" class="btn btn-sm btn-danger"
                                    onclick="return confirm('Удалить договор №@c.ContractNumber?')">
                                Удалить
                            </button>
                        </form>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>