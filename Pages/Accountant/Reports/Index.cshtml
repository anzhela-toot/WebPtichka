@page
@model WebPtichka.Pages.Accountant.Reports.IndexModel
@{
    ViewData["Title"] = "Отчёты";
}

<h1>Отчёты</h1>

<!-- ============ Фильтр по периоду ============ -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Дата с</label>
                <input type="date" name="dateFrom"
                       value="@(Model.DateFrom?.ToString("yyyy-MM-dd"))"
                       class="form-control" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Дата по</label>
                <input type="date" name="dateTo"
                       value="@(Model.DateTo?.ToString("yyyy-MM-dd"))"
                       class="form-control" />
            </div>

            <div class="col-md-6 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Применить</button>
                <a asp-page="/Accountant/Reports/Index" class="btn btn-secondary">Сбросить</a>
            </div>
        </form>

        <div class="mt-3 d-flex flex-wrap gap-2">
            @{
                var today = DateTime.Today;
                var monthStart = new DateTime(today.Year, today.Month, 1);
                var yearStart = new DateTime(today.Year, 1, 1);
                var weekStart = today.AddDays(-(int)today.DayOfWeek + 1);
            }
            <a href="?dateFrom=@today.ToString("yyyy-MM-dd")&dateTo=@today.ToString("yyyy-MM-dd")"
               class="btn btn-outline-primary btn-sm">Сегодня</a>
            <a href="?dateFrom=@weekStart.ToString("yyyy-MM-dd")&dateTo=@today.ToString("yyyy-MM-dd")"
               class="btn btn-outline-primary btn-sm">Эта неделя</a>
            <a href="?dateFrom=@monthStart.ToString("yyyy-MM-dd")&dateTo=@today.ToString("yyyy-MM-dd")"
               class="btn btn-outline-primary btn-sm">Этот месяц</a>
            <a href="?dateFrom=@yearStart.ToString("yyyy-MM-dd")&dateTo=@today.ToString("yyyy-MM-dd")"
               class="btn btn-outline-primary btn-sm">Этот год</a>
            <a href="?dateFrom=1900-01-01&dateTo=@today.ToString("yyyy-MM-dd")"
               class="btn btn-outline-primary btn-sm">Всё время</a>
        </div>
    </div>
</div>

<!-- ============ Сводка ============ -->
<h4 class="mb-3">
    Сводка за период
    @if (Model.DateFrom.HasValue || Model.DateTo.HasValue)
    {
        <span class="text-muted fs-6">
            (@Model.DateFrom?.ToString("dd.MM.yyyy") — @Model.DateTo?.ToString("dd.MM.yyyy"))
        </span>
    }
</h4>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-success">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 text-muted">💰 Доход</h6>
                <p class="card-text fs-3 fw-bold text-success">
                    @Model.TotalIncome.ToString("N2") ₽
                </p>
                <small class="text-muted">@Model.PaymentsCount платежей</small>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-primary">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 text-muted">📋 Выставлено</h6>
                <p class="card-text fs-3 fw-bold text-primary">
                    @Model.TotalIssued.ToString("N2") ₽
                </p>
                <small class="text-muted">@Model.InvoicesCount счетов</small>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-warning">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 text-muted">⏳ Ожидает</h6>
                <p class="card-text fs-3 fw-bold text-warning">
                    @Model.TotalUnpaid.ToString("N2") ₽
                </p>
                <small class="text-muted">@Model.UnpaidInvoicesCount счетов</small>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-danger">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 text-muted">⚠️ Просрочено</h6>
                <p class="card-text fs-3 fw-bold text-danger">
                    @Model.OverdueInvoices.Count
                </p>
                <small class="text-muted">счетов старше 30 дней</small>
            </div>
        </div>
    </div>
</div>

<!-- ============ Разбивка по клиентам ============ -->
<h4 class="mb-3">Разбивка по клиентам</h4>

@if (Model.ClientStatsList.Count == 0)
{
    <div class="alert alert-info">За выбранный период данных нет.</div>
}
else
{
    <table class="table table-striped table-hover mb-4">
        <thead>
            <tr>
                <th>Клиент</th>
                <th class="text-end">Договоров</th>
                <th class="text-end">Оплачено</th>
                <th class="text-end">Долг</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model.ClientStatsList)
            {
                <tr>
                    <td>@s.FullName</td>
                    <td class="text-end">@s.ContractsCount</td>
                    <td class="text-end text-success fw-bold">@s.PaidAmount.ToString("N2") ₽</td>
                    <td class="text-end @(s.DebtAmount > 0 ? "text-danger fw-bold" : "text-muted")">
                        @s.DebtAmount.ToString("N2") ₽
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<!-- ============ Разбивка по способам оплаты ============ -->
<h4 class="mb-3">Способы оплаты</h4>

@if (Model.MethodStatsList.Count == 0)
{
    <div class="alert alert-info">За выбранный период платежей не было.</div>
}
else
{
    <table class="table table-striped mb-4">
        <thead>
            <tr>
                <th>Способ</th>
                <th class="text-end">Кол-во</th>
                <th class="text-end">Сумма</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in Model.MethodStatsList)
            {
                <tr>
                    <td>@m.Method</td>
                    <td class="text-end">@m.Count</td>
                    <td class="text-end fw-bold">@m.Amount.ToString("N2") ₽</td>
                </tr>
            }
        </tbody>
    </table>
}

<!-- ============ Просроченные счета ============ -->
@if (Model.OverdueInvoices.Count > 0)
{
    <h4 class="mb-3 text-danger">⚠️ Просроченные счета</h4>
    <table class="table table-striped mb-4">
        <thead>
            <tr>
                <th>№ счёта</th>
                <th>Клиент</th>
                <th>Дата</th>
                <th class="text-end">Сумма</th>
                <th>Статус</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var inv in Model.OverdueInvoices)
            {
                <tr>
                    <td>@inv.InvoiceNumber</td>
                    <td>@inv.Contract?.Client?.FullName</td>
                    <td>@inv.InvoiceDate.ToString("dd.MM.yyyy")</td>
                    <td class="text-end fw-bold">@inv.Amount.ToString("N2") ₽</td>
                    <td><span class="badge bg-warning text-dark">@inv.InvoiceStatus</span></td>
                </tr>
            }
        </tbody>
    </table>
}

<!-- ============ Последние 10 платежей ============ -->
<h4 class="mb-3">Последние платежи</h4>

@if (Model.RecentPayments.Count == 0)
{
    <div class="alert alert-info">Платежей пока нет.</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Дата</th>
                <th>Клиент</th>
                <th>Счёт</th>
                <th>Способ</th>
                <th class="text-end">Сумма</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model.RecentPayments)
            {
                <tr>
                    <td>@p.PaymentDate.ToString("dd.MM.yyyy")</td>
                    <td>@p.Invoice?.Contract?.Client?.FullName</td>
                    <td>@p.Invoice?.InvoiceNumber</td>
                    <td>@p.PaymentMethod</td>
                    <td class="text-end fw-bold">@p.Amount.ToString("N2") ₽</td>
                </tr>
            }
        </tbody>
    </table>
}