@page
@model WebPtichka.Pages.Accountant.Invoices.IndexModel
@{
    ViewData["Title"] = "Счета";
}

<h1>Счета</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="mb-3">
    <a asp-page="/Accountant/Invoices/Create" class="btn btn-success">Добавить счёт</a>
</div>

<!-- ============ Поиск и фильтры ============ -->
<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label">Поиск</label>
                <input type="text" name="search" value="@Model.Search"
                       class="form-control"
                       placeholder="№ счёта или ФИО клиента..." />
            </div>

            <div class="col-md-3">
                <label class="form-label">Статус</label>
                <select name="status" class="form-select">
                    <option value="">Все статусы</option>
                    @foreach (var s in Model.StatusesList)
                    {
                        <option value="@s" selected="@(s == Model.Status)">@s</option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label">Дата с</label>
                <input type="date" name="dateFrom"
                       value="@(Model.DateFrom?.ToString("yyyy-MM-dd"))"
                       class="form-control" />
            </div>

            <div class="col-md-2">
                <label class="form-label">по</label>
                <input type="date" name="dateTo"
                       value="@(Model.DateTo?.ToString("yyyy-MM-dd"))"
                       class="form-control" />
            </div>

            <div class="col-md-1 d-flex gap-1">
                <button type="submit" class="btn btn-primary" title="Найти">🔍</button>
                <a asp-page="/Accountant/Invoices/Index" class="btn btn-secondary" title="Сбросить">✕</a>
            </div>
        </form>

        @if (!string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.Status)
             || Model.DateFrom.HasValue || Model.DateTo.HasValue)
        {
            <div class="mt-2 text-muted small">
                Найдено: <strong>@Model.Invoices.Count</strong> из @Model.TotalCount
            </div>
        }
    </div>
</div>

<!-- ============ Таблица ============ -->
@if (!Model.Invoices.Any())
{
    <div class="alert alert-info">
        @if (!string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.Status)
             || Model.DateFrom.HasValue || Model.DateTo.HasValue)
        {
            <span>🔍 По вашему запросу ничего не найдено.
                <a asp-page="/Accountant/Invoices/Index">Сбросить фильтры</a></span>
        }
        else
        {
            <span>Счетов пока нет.</span>
        }
    </div>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>№ счёта</th>
                <th>Клиент</th>
                <th>Сумма</th>
                <th>Дата</th>
                <th>Статус</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var inv in Model.Invoices)
            {
                <tr>
                    <td>@inv.InvoiceNumber</td>
                    <td>@inv.Contract?.Client?.FullName</td>
                    <td>@inv.Amount.ToString("N2") ₽</td>
                    <td>@inv.InvoiceDate.ToString("dd.MM.yyyy")</td>
                    <td>
                        @{
                            var statusClass = inv.InvoiceStatus?.ToLower() switch
                            {
                                "оплачен" or "paid" => "badge bg-success",
                                "выставлен" or "issued" => "badge bg-primary",
                                "частично оплачен" or "partial" => "badge bg-warning text-dark",
                                "отменён" or "отменен" or "cancelled" => "badge bg-danger",
                                _ => "badge bg-secondary"
                            };
                        }
                        <span class="@statusClass">@inv.InvoiceStatus</span>
                    </td>
                    <td class="text-nowrap">
                        <a asp-page="/Accountant/Invoices/Edit" asp-route-id="@inv.Id"
                           class="btn btn-sm btn-primary">Изменить</a>

                        @if (inv.InvoiceStatus != "Оплачен" && inv.InvoiceStatus != "Отменён")
                        {
                            <form method="post" asp-page-handler="AcceptPayment" asp-route-id="@inv.Id"
                                  onsubmit="return confirm('Принять оплату по счёту @inv.InvoiceNumber?');"
                                  class="d-inline">
                                <button type="submit" class="btn btn-sm btn-success">Оплатить</button>
                            </form>
                        }

                        <form method="post" asp-page-handler="Delete" asp-route-id="@inv.Id"
                              onsubmit="return confirm('Удалить счёт @inv.InvoiceNumber?');"
                              class="d-inline">
                            <button type="submit" class="btn btn-sm btn-danger">Удалить</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}