@page
@model WebPtichka.Pages.Accountant.Invoices.CreateModel
@{
    ViewData["Title"] = "Добавить счёт";
}

<h1>Добавить счёт</h1>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

<form method="post">
    <div class="mb-3">
        <label class="form-label">Договор *</label>
        <select asp-for="ContractId" asp-items="Model.ContractsList" class="form-select" required>
            <option value="">— Выберите договор —</option>
        </select>
        <small class="text-muted">Формат: номер договора — клиент — сумма</small>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label class="form-label">Сумма (₽) *</label>
            <input asp-for="Amount" type="number" step="0.01" min="0.01"
                   class="form-control" required />
        </div>

        <div class="col-md-4 mb-3">
            <label class="form-label">Дата счёта</label>
            <input asp-for="InvoiceDate" type="date" class="form-control" />
        </div>

        <div class="col-md-4 mb-3">
            <label class="form-label">Статус</label>
            <select asp-for="InvoiceStatus" class="form-select">
                <option value="Выставлен">Выставлен</option>
                <option value="Оплачен">Оплачен</option>
                <option value="Частично оплачен">Частично оплачен</option>
                <option value="Отменён">Отменён</option>
            </select>
        </div>
    </div>

    <button type="submit" class="btn btn-success">Создать счёт</button>
    <a asp-page="/Accountant/Invoices/Index" class="btn btn-secondary">Отмена</a>
</form>