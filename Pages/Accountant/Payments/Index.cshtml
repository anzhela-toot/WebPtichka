@page
@model WebPtichka.Pages.Accountant.Payments.IndexModel
@{
    ViewData["Title"] = "Платежи";
}

<h1>Платежи</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="mb-3">
    <a asp-page="/Accountant/Payments/Create" class="btn btn-success">Добавить платёж</a>
</div>

<!-- ============ Поиск и фильтры ============ -->
<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Поиск</label>
                <input type="text" name="search" value="@Model.Search"
                       class="form-control"
                       placeholder="№ счёта или ФИО клиента..." />
            </div>

            <div class="col-md-2">
                <label class="form-label">Способ</label>
                <select name="method" class="form-select">
                    <option value="">Все способы</option>
                    @foreach (var m in Model.MethodsList)
                    {
                        <option value="@m" selected="@(m == Model.Method)">@m</option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label">Статус</label>
                <select name="status" class="form-select">
                    <option value="">Все статусы</option>
                    @foreach (var s in Model.StatusesList)
                    {
                        <option value="@s" selected="@(s == Model.Status)">@s</option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label">Дата с</label>
                <input type="date" name="dateFrom"
                       value="@(Model.DateFrom?.ToString("yyyy-MM-dd"))"
                       class="form-control" />
            </div>

            <div class="col-md-2">
                <label class="form-label">по</label>
                <input type="date" name="dateTo"
                       value="@(Model.DateTo?.ToString("yyyy-MM-dd"))"
                       class="form-control" />
            </div>

            <div class="col-md-1 d-flex gap-1">
                <button type="submit" class="btn btn-primary" title="Найти">🔍</button>
                <a asp-page="/Accountant/Payments/Index" class="btn btn-secondary" title="Сбросить">✕</a>
            </div>
        </form>

        @if (!string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.Method)
             || !string.IsNullOrWhiteSpace(Model.Status)
             || Model.DateFrom.HasValue || Model.DateTo.HasValue)
        {
            <div class="mt-2 text-muted small">
                Найдено: <strong>@Model.Payments.Count</strong> из @Model.TotalCount
                @if (!string.IsNullOrWhiteSpace(Model.Search))
                {
                    <span> · по запросу «@Model.Search»</span>
                }
            </div>
        }
    </div>
</div>

<!-- ============ Таблица ============ -->
@if (!Model.Payments.Any())
{
    <div class="alert alert-info">
        @if (!string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.Method)
             || !string.IsNullOrWhiteSpace(Model.Status)
             || Model.DateFrom.HasValue || Model.DateTo.HasValue)
        {
            <span>🔍 По вашему запросу ничего не найдено.
                <a asp-page="/Accountant/Payments/Index">Сбросить фильтры</a></span>
        }
        else
        {
            <span>Платежей пока нет.</span>
        }
    </div>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Счёт</th>
                <th>Клиент</th>
                <th>Сумма</th>
                <th>Дата</th>
                <th>Способ</th>
                <th>Статус</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model.Payments)
            {
                <tr>
                    <td>@p.Invoice?.InvoiceNumber</td>
                    <td>@p.Invoice?.Contract?.Client?.FullName</td>
                    <td>@p.Amount.ToString("N2") ₽</td>
                    <td>@p.PaymentDate.ToString("dd.MM.yyyy")</td>
                    <td>@p.PaymentMethod</td>
                    <td>
                        @{
                            var statusClass = p.PaymentStatus?.ToLower() switch
                            {
                                "оплачено" or "paid" => "badge bg-success",
                                "ожидает" or "pending" => "badge bg-warning text-dark",
                                "отменено" or "cancelled" or "отменён" => "badge bg-danger",
                                _ => "badge bg-secondary"
                            };
                        }
                        <span class="@statusClass">@p.PaymentStatus</span>
                    </td>
                    <td>
                        <a asp-page="/Accountant/Payments/Edit" asp-route-id="@p.Id"
                           class="btn btn-sm btn-primary">Изменить</a>

                        <form method="post" asp-page-handler="Delete" asp-route-id="@p.Id"
                              onsubmit="return confirm('Удалить платёж?');" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-danger">Удалить</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}