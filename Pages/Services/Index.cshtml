@page
@model WebPtichka.Pages.Services.IndexModel
@{
    ViewData["Title"] = "Услуги";
}

<h1>Услуги</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="mb-3">
    <a asp-page="/Services/Create" class="btn btn-success">Добавить услугу</a>
</div>

<!-- Поиск и фильтры -->
<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label">Поиск</label>
                <input type="text" name="search" value="@Model.Search"
                       class="form-control"
                       placeholder="Название или описание..." />
            </div>

            <div class="col-md-2">
                <label class="form-label">Цена от</label>
                <input type="number" name="priceMin" value="@Model.PriceMin"
                       class="form-control" step="0.01" min="0" />
            </div>

            <div class="col-md-2">
                <label class="form-label">до</label>
                <input type="number" name="priceMax" value="@Model.PriceMax"
                       class="form-control" step="0.01" min="0" />
            </div>

            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill">🔍 Найти</button>
                <a asp-page="/Services/Index" class="btn btn-secondary">✕</a>
            </div>
        </form>

        @if (!string.IsNullOrWhiteSpace(Model.Search)
             || Model.PriceMin.HasValue || Model.PriceMax.HasValue)
        {
            <div class="mt-2 text-muted small">
                Найдено: <strong>@Model.Services.Count</strong> из @Model.TotalCount
            </div>
        }
    </div>
</div>

<!-- Таблица -->
@if (!Model.Services.Any())
{
    <div class="alert alert-info">
        @if (!string.IsNullOrWhiteSpace(Model.Search)
             || Model.PriceMin.HasValue || Model.PriceMax.HasValue)
        {
            <span>🔍 По вашему запросу ничего не найдено.
                <a asp-page="/Services/Index">Сбросить фильтры</a></span>
        }
        else
        {
            <span>Пока нет ни одной услуги.</span>
        }
    </div>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Название</th>
                <th>Описание</th>
                <th class="text-end">Цена</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model.Services)
            {
                <tr>
                    <td><strong>@s.ServiceName</strong></td>
                    <td class="text-muted">@s.Description</td>
                    <td class="text-end fw-bold">@s.ServicePrice.ToString("N2") ₽</td>
                    <td class="text-nowrap">
                        <a asp-page="/Services/Edit" asp-route-id="@s.Id"
                           class="btn btn-sm btn-primary">Изменить</a>

                        <form method="post" asp-page-handler="Delete"
                              asp-route-id="@s.Id" class="d-inline"
                              onsubmit="return confirm('Удалить услугу «@s.ServiceName»?');">
                            <button type="submit" class="btn btn-sm btn-danger">Удалить</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}