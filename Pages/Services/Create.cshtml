@page
@model WebPtichka.Pages.Services.CreateModel
@{
    ViewData["Title"] = "Добавить услугу";
}

<h1>Добавить услугу</h1>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

<form method="post">
    <div class="mb-3">
        <label asp-for="Service.ServiceName" class="form-label">Название услуги *</label>
        <input asp-for="Service.ServiceName" class="form-control" required />
    </div>

    <div class="mb-3">
        <label asp-for="Service.Description" class="form-label">Описание</label>
        <textarea asp-for="Service.Description" class="form-control" rows="3"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="Service.ServicePrice" class="form-label">Цена (₽) *</label>
        <input asp-for="Service.ServicePrice" type="number" step="0.01" min="0"
               class="form-control" required />
    </div>

    <button type="submit" class="btn btn-success">Сохранить</button>
    <a asp-page="/Services/Index" class="btn btn-secondary">Отмена</a>
</form>