@page
@model WebPtichka.Pages.Clients.IndexModel
@{
    ViewData["Title"] = "Клиенты";
}

<h1>Клиенты</h1>

<div class="mb-3">
    <a asp-page="/Clients/Create" class="btn btn-success">Добавить клиента</a>
    <a asp-page="/Index" class="btn btn-secondary">На главную</a>
</div>

<!-- ============ Панель поиска ============ -->
<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label">Поиск</label>
                <input type="text"
                       name="search"
                       value="@Model.Search"
                       class="form-control"
                       placeholder="ФИО, телефон или email..." />
            </div>

            <div class="col-md-3">
                <label class="form-label">Дата регистрации с</label>
                <input type="date"
                       name="dateFrom"
                       value="@(Model.DateFrom?.ToString("yyyy-MM-dd"))"
                       class="form-control" />
            </div>

            <div class="col-md-3">
                <label class="form-label">по</label>
                <input type="date"
                       name="dateTo"
                       value="@(Model.DateTo?.ToString("yyyy-MM-dd"))"
                       class="form-control" />
            </div>

            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill">🔍 Найти</button>
                <a asp-page="/Clients/Clients" class="btn btn-secondary">✕</a>
            </div>
        </form>

        @if (!string.IsNullOrWhiteSpace(Model.Search) || Model.DateFrom.HasValue || Model.DateTo.HasValue)
        {
            <div class="mt-2 text-muted small">
                Найдено: <strong>@Model.Clients.Count</strong> из @Model.TotalCount
                @if (!string.IsNullOrWhiteSpace(Model.Search))
                {
                    <span> · по запросу «@Model.Search»</span>
                }
            </div>
        }
    </div>
</div>

<!-- ============ Таблица ============ -->
<table class="table table-hover mt-3">
    <thead>
        <tr>
            <th>ID</th>
            <th>ФИО</th>
            <th>Телефон</th>
            <th>Email</th>
            <th>Дата регистрации</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Clients.Count == 0)
        {
            <tr>
                <td colspan="6" class="text-center text-muted py-4">
                    @if (!string.IsNullOrWhiteSpace(Model.Search) || Model.DateFrom.HasValue || Model.DateTo.HasValue)
                    {
                        <span>🔍 По вашему запросу ничего не найдено. <a asp-page="/Clients/Clients">Сбросить фильтры</a></span>
                    }
                    else
                    {
                        <span>Пока нет ни одного клиента</span>
                    }
                </td>
            </tr>
        }
        else
        {
            @foreach (var c in Model.Clients)
            {
                <tr>
                    <td>@c.Id</td>
                    <td>@c.FullName</td>
                    <td>@c.Phone</td>
                    <td>@c.Email</td>
                    <td>@c.RegistrationDate.ToString("dd.MM.yyyy")</td>
                    <td>
                        <a asp-page="/Clients/Edit" asp-route-id="@c.Id" class="btn btn-sm btn-primary">Изменить</a>

                        <form method="post" asp-page-handler="Delete"
                              asp-route-id="@c.Id" style="display:inline">
                            <button type="submit" class="btn btn-sm btn-danger"
                                    onclick="return confirm('Удалить клиента «@c.FullName»?')">
                                Удалить
                            </button>
                        </form>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>