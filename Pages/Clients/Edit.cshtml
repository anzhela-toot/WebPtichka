@page
@model WebPtichka.Pages.Clients.EditModel
@{
    ViewData["Title"] = "Редактировать клиента";
}

<h1>Редактировать клиента</h1>

<form method="post">
    <input type="hidden" asp-for="Client.Id" />
    
    <div class="mb-3">
        <label asp-for="Client.FullName" class="form-label">ФИО *</label>
        <input asp-for="Client.FullName" class="form-control" required />
    </div>

    <div class="mb-3">
        <label asp-for="Client.Phone" class="form-label">Телефон *</label>
        <input asp-for="Client.Phone" type="tel" class="form-control" required />
    </div>

    <div class="mb-3">
        <label asp-for="Client.Email" class="form-label">Email</label>
        <input asp-for="Client.Email" type="email" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">Сохранить</button>
    <a asp-page="/Clients/Clients" class="btn btn-secondary">Отмена</a>
</form>