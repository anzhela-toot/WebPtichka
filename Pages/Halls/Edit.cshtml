@page
@model WebPtichka.Pages.Halls.EditModel
@{
    ViewData["Title"] = "Редактировать зал";
}

<h1>Редактировать зал</h1>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

<form method="post">
    <input type="hidden" asp-for="Hall.Id" />

    <div class="mb-3">
        <label asp-for="Hall.HallName" class="form-label">Название зала *</label>
        <input asp-for="Hall.HallName" class="form-control" required />
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Hall.Capacity" class="form-label">Вместимость (чел.) *</label>
            <input asp-for="Hall.Capacity" type="number" min="1" class="form-control" required />
        </div>

        <div class="col-md-6 mb-3">
            <label asp-for="Hall.PricePerHour" class="form-label">Цена за час (₽) *</label>
            <input asp-for="Hall.PricePerHour" type="number" step="0.01" min="0.01"
                   class="form-control" required />
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Hall.HallStatus" class="form-label">Статус</label>
        <select asp-for="Hall.HallStatus" class="form-select">
            <option value="Доступен">Доступен</option>
            <option value="Занят">Занят</option>
            <option value="Ремонт">Ремонт</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="Hall.Description" class="form-label">Описание</label>
        <textarea asp-for="Hall.Description" class="form-control" rows="3"></textarea>
    </div>

    <button type="submit" class="btn btn-success">Сохранить</button>
    <a asp-page="/Halls/Index" class="btn btn-secondary">Отмена</a>
</form>