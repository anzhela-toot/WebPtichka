@page
@model WebPtichka.Pages.Schedule.IndexModel
@{
    ViewData["Title"] = "Расписание";
}

<!-- Скрытая форма для токена безопасности (нужна для Drag-and-Drop) -->
<form method="post" id="antiForgeryForm">
    @Html.AntiForgeryToken()
</form>

<h1>Расписание бронирований</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="mb-3">
    <a asp-page="/Schedule/Create" class="btn btn-success">Добавить бронирование</a>
</div>

<!-- ============ ФИЛЬТР ПО ЗАЛУ ============ -->
<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label">Фильтр по залу</label>
                <select name="hallId" class="form-select" asp-items="Model.HallsList" onchange="this.form.submit()">
                    <option value="">Все залы</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary">Применить</button>
                <a asp-page="/Schedule/Index" class="btn btn-secondary">Сбросить</a>
            </div>
        </form>
    </div>
</div>

<!-- ============ ВКЛАДКИ ============ -->
<ul class="nav nav-tabs mb-3" id="viewTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="calendar-tab" data-bs-toggle="tab"
                data-bs-target="#calendar-view" type="button" role="tab">
            📅 Календарь
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="list-tab" data-bs-toggle="tab"
                data-bs-target="#list-view" type="button" role="tab">
            📋 Список
        </button>
    </li>
</ul>

<div class="tab-content" id="viewTabsContent">

    <!-- ========================================== -->
    <!-- ВКЛАДКА 1: КАЛЕНДАРЬ                       -->
    <!-- ========================================== -->
    <div class="tab-pane fade show active" id="calendar-view" role="tabpanel">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <a href="?weekStart=@Model.CurrentWeekStart.AddDays(-7).ToString("yyyy-MM-dd")&hallId=@Model.HallId"
               class="btn btn-outline-primary">← Предыдущая неделя</a>
            <h5 class="mb-0">
                @Model.CurrentWeekStart.ToString("dd.MM") — @Model.CurrentWeekStart.AddDays(6).ToString("dd.MM.yyyy")
            </h5>
            <a href="?weekStart=@Model.CurrentWeekStart.AddDays(7).ToString("yyyy-MM-dd")&hallId=@Model.HallId"
               class="btn btn-outline-primary">Следующая неделя →</a>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered calendar-table text-center align-middle">
                <thead class="table-light">
                    <tr>
                        <th style="width: 80px;">Время</th>
                        @for (int i = 0; i < 7; i++)
                        {
                            var day = Model.CurrentWeekStart.AddDays(i);
                            var isToday = day == DateOnly.FromDateTime(DateTime.Today);
                            <th class="@(isToday ? "bg-primary text-white" : "")">
                                @day.ToString("ddd")<br />
                                <small>@day.ToString("dd.MM")</small>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @for (int hour = 8; hour < 22; hour++)
                    {
                        <tr>
                            <td class="text-muted small bg-light">@hour:00</td>
                            @for (int i = 0; i < 7; i++)
                            {
                                var day = Model.CurrentWeekStart.AddDays(i);
                                var bookings = Model.WeekSchedules
                                    .Where(s => s.BookingDate == day && s.StartTime.Hour == hour)
                                    .ToList();

                                <td style="vertical-align: top; padding: 2px; min-width: 120px; background-color: #fafafa;"
                                    ondragover="event.preventDefault();"
                                    ondrop="drop(event, '@day.ToString("yyyy-MM-dd")', @hour)">
                                    
                                    @foreach (var b in bookings)
                                    {
                                        <div class="booking-block rounded p-1 mb-1"
                                             draggable="true"
                                             ondragstart="dragStart(event, @b.Id)"
                                             onclick="window.location='/Schedule/Edit?id=@b.Id'"
                                             style="background: #D4A24C; color: white; font-size: 0.75rem; cursor: grab;"
                                             title="Кликните, чтобы изменить. Или перетащите на другое время.">
                                            <strong>@b.StartTime.ToString("HH:mm")—@b.EndTime.ToString("HH:mm")</strong><br />
                                            @b.Hall?.HallName<br />
                                            @b.Contract?.Client?.FullName
                                        </div>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- ========================================== -->
    <!-- ВКЛАДКА 2: СПИСОК                          -->
    <!-- ========================================== -->
    <div class="tab-pane fade" id="list-view" role="tabpanel">

        <!-- Поиск и фильтры списка -->
        <div class="card mb-3">
            <div class="card-body">
                <form method="get" class="row g-3 align-items-end">
                    <input type="hidden" name="hallId" value="@Model.HallId" />

                    <div class="col-md-3">
                        <label class="form-label">Поиск</label>
                        <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="№ договора или клиент..." />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Статус</label>
                        <select name="status" class="form-select">
                            <option value="">Все статусы</option>
                            @foreach (var s in Model.StatusesList)
                            {
                                <option value="@s" selected="@(s == Model.Status)">@s</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Дата с</label>
                        <input type="date" name="dateFrom" value="@(Model.DateFrom?.ToString("yyyy-MM-dd"))" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">по</label>
                        <input type="date" name="dateTo" value="@(Model.DateTo?.ToString("yyyy-MM-dd"))" class="form-control" />
                    </div>
                    <div class="col-md-3 d-flex gap-1">
                        <button type="submit" class="btn btn-primary flex-fill" title="Найти">🔍 Найти</button>
                        <a asp-page="/Schedule/Index" class="btn btn-secondary" title="Сбросить">✕</a>
                    </div>
                </form>
            </div>
        </div>

        @if (!Model.SchedulesList.Any())
        {
            <div class="alert alert-info">По вашему запросу ничего не найдено.</div>
        }
        else
        {
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Дата</th>
                        <th>Время</th>
                        <th>Зал</th>
                        <th>Клиент</th>
                        <th>Договор</th>
                        <th>Статус</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.SchedulesList)
                    {
                        <tr>
                            <td>@s.BookingDate.ToString("dd.MM.yyyy")</td>
                            <td>@s.StartTime.ToString("HH:mm") – @s.EndTime.ToString("HH:mm")</td>
                            <td>@s.Hall?.HallName</td>
                            <td>@s.Contract?.Client?.FullName</td>
                            <td>@s.Contract?.ContractNumber</td>
                            <td>
                                @{
                                    var statusClass = s.ScheduleStatus?.ToLower() switch
                                    {
                                        "подтверждено" or "confirmed" => "badge bg-success",
                                        "ожидает подтверждения" or "pending" => "badge bg-warning text-dark",
                                        "отменено" or "cancelled" => "badge bg-danger",
                                        "завершено" or "completed" => "badge bg-secondary",
                                        _ => "badge bg-secondary"
                                    };
                                }
                                <span class="@statusClass">@s.ScheduleStatus</span>
                            </td>
                            <td class="text-nowrap">
                                <a asp-page="/Schedule/Edit" asp-route-id="@s.Id" class="btn btn-sm btn-primary">Изменить</a>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@s.Id" class="d-inline"
                                      onsubmit="return confirm('Удалить бронирование?');">
                                    <button type="submit" class="btn btn-sm btn-danger">Удалить</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<!-- ========================================== -->
<!-- СКРИПТ ДЛЯ ПЕРЕТАСКИВАНИЯ                  -->
<!-- ========================================== -->
<script>
    let draggedScheduleId = null;

    function dragStart(event, id) {
        draggedScheduleId = id;
        event.dataTransfer.effectAllowed = 'move';
        event.target.style.opacity = '0.5';
    }

    function drop(event, newDate, newHour) {
        event.preventDefault();
        
        // Возвращаем прозрачность
        document.querySelectorAll('.booking-block').forEach(el => el.style.opacity = '1');

        if (!draggedScheduleId) return;

        // Берем токен безопасности из формы
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        if (!token) {
            alert("Ошибка: не найден токен безопасности. Обновите страницу (F5).");
            draggedScheduleId = null;
            return;
        }

        // Отправляем запрос на сервер
        fetch('?handler=UpdateSchedule', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token // Передаем токен
            },
            body: JSON.stringify({
                id: draggedScheduleId,
                newDate: newDate,
                newHour: newHour
            })
        })
        .then(response => {
            if (response.ok) {
                window.location.reload(); // Обновляем страницу при успехе
            } else {
                response.text().then(text => alert('Ошибка: ' + text));
            }
        })
        .catch(error => alert('Ошибка сети: ' + error));

        draggedScheduleId = null;
    }

    // Убираем прозрачность, если перетаскивание отменили
    document.addEventListener('dragend', () => {
        document.querySelectorAll('.booking-block').forEach(el => el.style.opacity = '1');
        draggedScheduleId = null;
    });
</script>