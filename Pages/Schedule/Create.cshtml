@page
@model WebPtichka.Pages.Schedule.CreateModel
@{
    ViewData["Title"] = "Добавить бронирование";
}

<h1>Добавить бронирование</h1>
<p>Заполните информацию о бронировании зала.</p>

<form method="post">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Schedule.BookingDate" class="form-label">Дата бронирования</label>
        <input asp-for="Schedule.BookingDate" type="date" class="form-control" required />
        <span asp-validation-for="Schedule.BookingDate" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Schedule.StartTime" class="form-label">Время начала</label>
            <input asp-for="Schedule.StartTime" type="time" class="form-control" required />
            <span asp-validation-for="Schedule.StartTime" class="text-danger"></span>
        </div>

        <div class="col-md-6 mb-3">
            <label asp-for="Schedule.EndTime" class="form-label">Время окончания</label>
            <input asp-for="Schedule.EndTime" type="time" class="form-control" required />
            <span asp-validation-for="Schedule.EndTime" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Schedule.HallId" class="form-label">Зал</label>
        <select asp-for="Schedule.HallId" asp-items="Model.HallsList"
                class="form-select" required>
            <option value="">-- Выберите зал --</option>
        </select>
        <span asp-validation-for="Schedule.HallId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Schedule.ContractId" class="form-label">Договор</label>
        <select asp-for="Schedule.ContractId" asp-items="Model.ContractsList"
                class="form-select" required>
            <option value="">-- Выберите договор --</option>
        </select>
        <span asp-validation-for="Schedule.ContractId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Schedule.ScheduleStatus" class="form-label">Статус бронирования</label>
        <select asp-for="Schedule.ScheduleStatus" class="form-select" required>
            <option value="Подтверждено">Подтверждено</option>
            <option value="Ожидает подтверждения">Ожидает подтверждения</option>
            <option value="Отменено">Отменено</option>
        </select>
        <span asp-validation-for="Schedule.ScheduleStatus" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Сохранить бронирование</button>
    <a asp-page="/Schedule/Index" class="btn btn-secondary">Отмена</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}